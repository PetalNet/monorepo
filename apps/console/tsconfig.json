{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["vite/client"],
		"moduleResolution": "bundler",
		"rootDirs": ["src", ".svelte-kit/types/src"],
		// Pinned, not inherited. `.svelte-kit/tsconfig.json` is regenerated by every
		// `svelte-kit sync`, and SvelteKit only emits the $lib alias when it finds `src/lib`
		// relative to the *process* cwd (write_tsconfig.js: `existsSync(project_relative(...))`).
		// This app is the only one whose kit config lives in vite.config.ts rather than a
		// svelte.config.js, so loading that config from the workspace root -- which any `vp`
		// command does -- re-syncs with the wrong cwd and silently drops $lib, leaving every
		// `$lib/...` import an unresolved 'error' type. `include` below is already overridden for
		// the same reason; these paths close the other half.
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$app/types": ["./.svelte-kit/types/index.d.ts"]
		},
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnosticSeverity": {},
				"ignoreEffectSuggestionsInTscExitCode": false
			}
		]
	},
	"include": [
		".svelte-kit/env.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"test/**/*.ts",
		"effectdb.config.ts",
		"vite.config.ts",
		"playwright.config.ts"
	]
}
