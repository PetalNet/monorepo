{
	"schema_version": 1,
	"site_id": "example",
	"crs": "EPSG:32613",
	"boundary": [
		[500100.0, 4400100.0],
		[500900.0, 4400100.0],
		[500900.0, 4400800.0],
		[500100.0, 4400800.0]
	],
	"tile": { "size_m": 1008, "quad_m": 0.5 },
	"target_date": "2030-06",
	"seed": 1,
	"vertical_datum": "state the datum and geoid model of the elevation source here",
	"context": { "size_m": 4032 },
	"sources": {
		"lidar": {
			"kind": "file",
			"path": "points.laz",
			"license": "licence of the lidar",
			"date": "survey date"
		},
		"elevation": {
			"kind": "arcgis_imageserver",
			"endpoint": "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer",
			"request_spacing_m": 1.0,
			"license": "USGS 3DEP, public domain",
			"date": "survey date of the lidar under the site"
		},
		"canopy_height": {
			"kind": "cog",
			"url": "/vsicurl/https://example.com/canopy-height/tile.tif",
			"license": "licence of the canopy height raster",
			"date": "date of the imagery it was derived from"
		},
		"imagery": {
			"kind": "file",
			"path": "imagery.tif",
			"license": "licence of the imagery",
			"date": "2030-06-15, the acquisition day, which places the sun",
			"bands": { "red": 1, "green": 2, "blue": 3, "nir": 4 }
		},
		"reflectance": {
			"kind": "file",
			"path": "reflectance.tif",
			"license": "licence of the reflectance raster",
			"date": "2030-06, near the target date",
			"bands": { "blue": 1, "green": 2, "red": 3 }
		}
	}
}
