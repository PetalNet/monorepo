[Unit]
Description=HA call requests to Janet's encrypted Matrix DM
After=network-online.target
Wants=network-online.target

[Service]
User=docker
UMask=0077
ExecStart=/home/docker/.claude/system-sender/venv/bin/python /home/docker/.local/lib/janet-call-trigger/sender.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
