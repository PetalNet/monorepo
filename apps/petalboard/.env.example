# Environment variables example file

# Database configuration (local development; the container pins /app/data/dev.db)
DATABASE_URL="file:./prisma/dev.db"

# Public URL; form actions fail the CSRF check without it in production
ORIGIN="http://localhost:5173"

# Email (Resend); see EMAIL_SETUP.md
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="PetalBoard <rsvp@petalcat.dev>"

APP_URL="https://your_app_url.com"

# Host login (Authentik OpenID Connect)
OIDC_ISSUER="https://auth.example.com/application/o/petalboard/"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_REQUIRED_GROUP="petalboard-hosts"

# Google Maps API
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Geocoding API
PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Spotify API Credentials
# Get your credentials from: https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your_app_url.com/api/spotify/callback

# Note: Remember to replace placeholder values with your actual configuration details before using this file.
