<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

	<application
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="@string/app_name"
		android:theme="@style/Theme.JanetCall">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTask"
			android:screenOrientation="portrait">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- The pairing link. Any app or page can fire it, so MainActivity asks before it pairs. -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="janetcall" android:host="pair" />
			</intent-filter>
			<!-- "Call Janet" on a long press of the launcher icon. It is an explicit intent with a private
			     action and no intent filter, so no web page or link can start a call. Another installed app
			     can still send the same explicit intent: it opens the call screen and the usual permission
			     questions, and nothing it can send skips them. -->
			<meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
		</activity>

		<service
			android:name=".JanetConnectionService"
			android:exported="true"
			android:foregroundServiceType="phoneCall|microphone"
			android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
			<intent-filter>
				<action android:name="android.telecom.ConnectionService" />
			</intent-filter>
		</service>
	</application>
</manifest>
