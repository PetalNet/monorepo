<?xml version="1.0" encoding="utf-8"?>
<!-- The planet from the call screen, reduced to a disc and a tilted ring so it still reads at 48 dp.
     The live area of an adaptive icon is the middle 66 of 108 dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
	android:width="108dp"
	android:height="108dp"
	android:viewportWidth="108"
	android:viewportHeight="108">
	<group android:pivotX="54" android:pivotY="54" android:rotation="-24">
		<!-- The far half of the ring, behind the planet. -->
		<path
			android:pathData="M26,54 A28,9 0 0,1 82,54"
			android:strokeColor="#FFA2A29E"
			android:strokeLineCap="round"
			android:strokeWidth="4" />
	</group>
	<path
		android:fillColor="#FFF3F3EF"
		android:pathData="M54,54m-18,0a18,18 0 1,0 36,0a18,18 0 1,0 -36,0" />
	<group android:pivotX="54" android:pivotY="54" android:rotation="-24">
		<!-- A gap in the planet's colour under the near half, so the ring reads as passing in front. -->
		<path
			android:pathData="M26,54 A28,9 0 0,0 82,54"
			android:strokeColor="#FF0B0B0B"
			android:strokeLineCap="round"
			android:strokeWidth="9" />
		<path
			android:pathData="M26,54 A28,9 0 0,0 82,54"
			android:strokeColor="#FFF3F3EF"
			android:strokeLineCap="round"
			android:strokeWidth="4" />
	</group>
</vector>
