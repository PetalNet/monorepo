# runtime agent-fleet heartbeat (written by the warm session/manager, read by the rail)
data/agent-fleet-status.json
# ElevenLabs TTS key — secret; never commit
data/eleven-api-key

# local board verification artifacts (screenshots) — not app source
_board-verify/

# vendored exploration artifacts (matrix-rust-sdk / wasm clones) — NOT build deps, ~62M
matrix-rust-sdk/
matrix-sdk-crypto-wasm/
wasm/
mjs/
matrix-*.tgz
matrix-org-*.tgz
# generated / temp
data/keeper-reports/
# per-agent fleet heartbeats (runtime-written)
data/fleet/*.json
*.bak-archive
