{
	"name": "@petalnet/tasks",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"lint:eslint": "eslint . --max-warnings=0",
		"prepare": "svelte-kit sync",
		"test": "node scripts/test-public-share.mjs && node scripts/test-agent-api.mjs && node scripts/test-janet-home.mjs && node scripts/test-telemetry.mjs && node scripts/test-makkit-docs.mjs && node --experimental-strip-types scripts/test-agents-snapshot.mjs && vitest run"
	},
	"dependencies": {
		"@sentry/core": "catalog:prod",
		"@sentry/node": "catalog:prod",
		"better-sqlite3": "catalog:prod",
		"effect": "catalog:",
		"rehype-sanitize": "catalog:prod",
		"rehype-stringify": "catalog:prod",
		"remark-breaks": "catalog:prod",
		"remark-gfm": "catalog:prod",
		"remark-parse": "catalog:prod",
		"remark-rehype": "catalog:prod",
		"unified": "catalog:prod",
		"zod": "catalog:prod"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "catalog:prod",
		"@fontsource-variable/geist-mono": "catalog:prod",
		"@lucide/svelte": "catalog:prod",
		"@petalnet/effect-api": "workspace:*",
		"@petalnet/effect-sveltekit": "workspace:*",
		"@sentry/sveltekit": "catalog:prod",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:dev",
		"@types/better-sqlite3": "catalog:types",
		"svelte": "catalog:prod",
		"svelte-check": "catalog:dev",
		"vite": "catalog:dev",
		"vitest": "catalog:dev"
	}
}
