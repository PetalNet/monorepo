# Public origin used by SvelteKit.
ORIGIN=https://tracker.example.com
# Directory mounted at /data by compose.
TASKS_DATA_DIR=/path/to/tasks-data
# SQLite database path used by the app and maintenance scripts.
TASKS_DB_PATH=/data/tasks.db
# Optional JSON configuration file mounted from the data directory.
TASKS_CONFIG=/data/config.json
# Comma-separated authenticated users allowed to access the app.
ALLOW=alice,bob
# Comma-separated users allowed to open a read-write terminal; empty denies all.
TERM_ADMIN=
# Secret required by ttyd clients.
TERM_WS_SECRET=replace-me
# Secret injected by the reverse proxy for terminal websocket requests.
TERM_PROXY_SECRET=replace-me
# Host port for the task service.
TASKS_PORT=8896
# IANA timezone used by the runtime.
TZ=UTC
# Required destination for archived event files.
TASKS_ARCHIVE_DIR=/data/archive
# Tmux socket directory exposed to terminal containers.
TASKS_TERM_TMUX_SOCKET_DIR=/tmp/tmux-1000
# Tmux session exposed to terminal containers.
TASKS_TERM_TMUX_SESSION=tracker
# Optional ElevenLabs API key.
ELEVEN_API_KEY=
# Optional comma-separated name=id ElevenLabs voice map.
ELEVEN_VOICES=
