# Public origin used by SvelteKit.
ORIGIN=https://tracker.example.com
# Directory mounted at /data by compose.
TASKS_DATA_DIR=/path/to/tasks-data
# SQLite database path used by the app and maintenance scripts.
TASKS_DB_PATH=/data/tasks.db
# Optional JSON configuration file mounted from the data directory.
TASKS_CONFIG=/data/config.json
# Comma-separated authenticated users allowed to access the app.
ALLOW=alice,bob
# Dedicated bearer token for POST /api/agent/agents/snapshot; empty disables ingest.
TASKS_AGENTS_INGEST_TOKEN=
# Host port for the gallery service.
TASKS_PORT=8896
# IANA timezone used by the runtime.
TZ=UTC
# Optional Glitchtip (Sentry-compatible) DSNs for server and browser errors; empty disables reporting.
GLITCHTIP_DSN=
PUBLIC_GLITCHTIP_DSN=
# Optional environment label for reported errors (default production).
GLITCHTIP_ENV=
PUBLIC_GLITCHTIP_ENV=
# Set to 1 to enable /api/debug/glitchtip, which throws a test error.
GLITCHTIP_DEBUG=
# scripts/sync-makkit-docs.mjs mirrors gallery pages tagged collection='makkit' into the Makkit staff Docs reader.
# Makkit API base URL, its anon key, and the path of a file holding a docs_publish agent key (never the key itself).
MAKKIT_API_URL=
MAKKIT_ANON_KEY=
MAKKIT_AGENT_KEY_FILE=
# Matrix announcements for answers given on published pages. MATRIX_ROOM is an unencrypted room the
# bot has joined; MATRIX_TOKEN_FILE_HOST is the host path of a file holding the bot's access token.
MATRIX_HOMESERVER=
MATRIX_ROOM=
MATRIX_TOKEN_FILE_HOST=
# What's ongoing: open pull requests with their checks and review state. GITHUB_PULLS_SEARCH is a
# GitHub search, for example "org:acme is:pr is:open archived:false"; every signed-in viewer sees
# every pull request it finds, so exclude repositories there ("-repo:acme/private"). GITHUB_TOKEN_FILE_HOST
# is the host path of a file holding a fine-grained token with read access to pull requests, commit
# statuses and actions. Leave the search empty to turn the list off.
GITHUB_PULLS_SEARCH=
GITHUB_TOKEN_FILE_HOST=
# Follow-through defaults closed. See FOLLOW-THROUGH.md for the host command bridge.
FOLLOW_THROUGH_OPERATORS=
FOLLOW_THROUGH_COMMAND_ARGV=
