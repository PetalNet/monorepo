[Unit]
Description=Rebuild Janet's home page (/janet/home) from live lab status

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/janet-home/env
# Needs JANET_LAB_DOCKER_SSH=user@host in ~/.config/janet-home/env. Run from a checkout of main. Token file: ~/.config/janet-home/token (unscoped write agent token).
ExecStart=/usr/bin/env node %h/work/monorepo/apps/tasks/scripts/janet-lab-status.mjs
TimeoutStartSec=60
