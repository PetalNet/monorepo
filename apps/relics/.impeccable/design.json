	"narrative": {
		"northStar": "The Specimen Card",
		"overview": "Parker's selected world is a dark specimen card and museum label, with artwork first and a light theme toggle. Existing photography and real specimen data lead; catalog numbers and hairline rules give the interface its quiet structure. This is a code-led implementation, with no approved raster comp.\n\nThe specimen route is Experience; the private collection and admin tools are Operate. ENERGY 2 / RHYTHM 2 / MOTION 1. The collection uses photographs for owned relics and a custom mushroom silhouette for missing varieties, never substitute artwork.",
		"keyCharacteristics": [
			"Real object photography and an oversized catalog number.",
			"Flat charcoal and warm paper, with a restrained herb-green accent.",
			"Schibsted Grotesk, small corners, hairline divisions and short state transitions."
		],
		"rules": [
			{
				"name": "The Artwork First Rule",
				"body": "Let the photograph carry the visual weight; use the accent to guide action and catalog identification.",
				"section": "colors"
			}
		],
		"dos": [
			"Do keep real photography and specimen data foremost.",
			"Do preserve the same hierarchy in both themes and visible keyboard focus.",
			"Do use silhouettes with an explicit missing or uncollected state."
		],
		"donts": [
			"Don't replace specimen artwork with invented imagery.",
			"Don't add public owner lists, social rankings, invented lore or unsupported count claims.",
			"Don't add heavy decorative effects to the flat museum-label world."
