{
	"name": "@petalnet/slide",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"generate": "prisma generate",
		"lint:eslint": "eslint . --max-warnings=0",
		"prepare": "svelte-kit sync && prisma generate",
		"preview": "vite preview"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "catalog:prod",
		"@prisma/client": "catalog:prod"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "catalog:dev",
		"@sveltejs/kit": "catalog:prod",
		"@sveltejs/vite-plugin-svelte": "catalog:dev",
		"@tailwindcss/vite": "catalog:dev",
		"@types/qrcode": "catalog:types",
		"@types/sortablejs": "catalog:types",
		"bcryptjs": "catalog:prod",
		"date-fns": "catalog:prod",
		"nanoid": "catalog:prod",
		"prisma": "catalog:dev",
		"qrcode": "catalog:prod",
		"sortablejs": "catalog:prod",
		"svelte": "catalog:prod",
		"svelte-check": "catalog:dev",
		"tailwindcss": "catalog:prod",
		"typescript": "catalog:dev",
		"vite": "catalog:dev"
	}
}
