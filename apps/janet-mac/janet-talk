#!/bin/bash
# Talk to Janet from a key: `janet-talk start` on key down, `janet-talk stop` on key up.
# Hold the key and talk, or tap it and talk until you stop.
# Records and transcribes through the local Hex app, sends the text to the voice head
# through the voice gateway, shows the reply as a notification and plays it.
# Nothing runs between presses.
set -u

CONFIG="${JANET_TALK_CONFIG:-$HOME/.config/janet-talk/config}"
STATE="${JANET_TALK_STATE:-$HOME/Library/Caches/janet-talk}"
HEX_API="${JANET_TALK_HEX_API:-$HOME/Library/Application Support/hex/local-api.json}"
# Where install.sh puts turn_end.py, its Python environment and its speech model.
TURN_END="${JANET_TALK_TURN_END:-$HOME/.local/share/janet-talk}"
KEYCHAIN_SERVICE="janet-voice"
CONVERSATION_IDLE_S=90 # the head ends a conversation itself after 120 s without a turn
VOICE_WAKE_WAIT_S="${JANET_TALK_WAKE_WAIT_S:-240}"
RETRY_S="${JANET_TALK_RETRY_S:-5}"
# A second press shorter than this is a tap: Janet then listens until the speaker stops.
LATCH_MS="${JANET_TALK_LATCH_MS:-400}"
END_OF_SPEECH_S="${JANET_TALK_END_OF_SPEECH_S:-1.3}"
NO_SPEECH_S="${JANET_TALK_NO_SPEECH_S:-6}"
# No limit on how long someone may talk: listening ends on quiet. This is only a backstop.
MAX_LISTEN_S="${JANET_TALK_MAX_LISTEN_S:-300}"
HEARTBEAT_S="${JANET_TALK_HEARTBEAT_S:-3}"
# How many times in one turn a reply may be dropped because the speaker went on talking.
MAX_RESUMES="${JANET_TALK_MAX_RESUMES:-4}"
# Built by install.sh. Without it, nothing is paused.
MEDIA_DIR="${JANET_TALK_MEDIA_DIR:-$HOME/.local/share/janet-talk/mediaremote-adapter}"
MEDIA_TIMEOUT_S="${JANET_TALK_MEDIA_TIMEOUT_S:-2}"
# A pause older than any reply can last is a leftover, not something to resume.
MEDIA_STALE_S=1200

# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"
# Whole seconds: shell arithmetic and the recording's keep-alive count with it.
case "$MAX_LISTEN_S" in "" | *[!0-9]*) MAX_LISTEN_S=300 ;; esac
URL="${JANET_VOICE_URL:-}"
CHANNEL="${JANET_VOICE_CHANNEL:-mac}"

mkdir -p "$STATE"
LOG="$STATE/talk.log"

# Karabiner does not let a key's command outlive the next one: the key-up command arriving
# cut the key-down command short. So each key event carries on in a session of its own, and
# the command Karabiner started returns at once.
case "${1:-}" in
  start | stop)
    if [ -z "${JANET_TALK_DETACHED:-}" ]; then
      JANET_TALK_DETACHED=1 exec perl -MPOSIX -e 'fork and exit; setsid(); exec @ARGV' \
        /bin/bash "$0" "$@" </dev/null >/dev/null 2>>"$LOG"
    fi
    ;;
esac

now_ms() { perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000'; }
log() { echo "$(now_ms) $*" >>"$LOG"; }

notify() { # title, text
  osascript - "$1" "$2" >/dev/null 2>&1 <<'OSA' &
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
OSA
}

secret() { security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w 2>/dev/null; }

load_secrets() {
  local value
  CF_ID=$(secret cf-access-client-id) && CF_SECRET=$(secret cf-access-client-secret) && HEAD_TOKEN=$(secret head-token) || return 1
  [ -n "$URL" ] || return 1
  # The values go into curl config lines. Tokens are made of these characters; anything else is refused.
  for value in "$CF_ID" "$CF_SECRET" "$HEAD_TOKEN"; do
    case "$value" in "" | *[!A-Za-z0-9._~+/=-]*) return 1 ;; esac
  done
}

# Secrets reach curl on stdin, so they never show up in a process list.
api() { # path, body file, extra curl args...
  local path="$1" body="$2"
  shift 2
  {
    printf 'header = "CF-Access-Client-Id: %s"\n' "$CF_ID"
    printf 'header = "CF-Access-Client-Secret: %s"\n' "$CF_SECRET"
    printf 'header = "Authorization: Bearer %s"\n' "$HEAD_TOKEN"
  } | curl -sS -K - -X POST -H 'content-type: application/json' --data-binary "@$body" "$@" "$URL$path"
}

# --- Hex, over its local API ---------------------------------------------------------
# A recording made this way is never pasted, and Hex reports the microphone level while it runs.

hex() { # method, path, extra curl args...   (HEX_OWNER, when set, is the recording's owner token)
  local method="$1" path="$2" port token
  shift 2
  read -r port token < <(jq -r '"\(.port) \(.token)"' "$HEX_API" 2>/dev/null)
  # The values go into a URL and a curl config line, so only a port number and token characters pass.
  case "${port:-}" in "" | *[!0-9]*) return 7 ;; esac
  case "${token:-}${HEX_OWNER:-}" in "" | *[!A-Za-z0-9._~+/=-]*) return 7 ;; esac
  {
    printf 'header = "Authorization: Bearer %s"\n' "$token"
    [ -n "${HEX_OWNER:-}" ] && printf 'header = "X-Hex-Dictation-Token: %s"\n' "$HEX_OWNER"
  } | curl -sS -K - --proto =http -X "$method" "$@" "http://127.0.0.1:$port$path" 2>/dev/null
}

# Starts a recording. Leaves "<id> <owner token> <press ms>" in the recording file, or in the
# state file named.
hex_start() { # press ms, [state file]
  local reply id owner until file="${2:-recording}"
  reply=$(hex POST /dictations --max-time 5 -H 'content-type: application/json' -d '{"source":"janet-talk"}') || return 1
  id=$(printf '%s' "$reply" | jq -r '.id // empty' 2>/dev/null)
  owner=$(printf '%s' "$reply" | jq -r '.ownerToken // empty' 2>/dev/null)
  case "$id" in "" | *[!0-9A-Za-z_-]*) return 1 ;; esac
  [ -n "$owner" ] || return 1
  printf '%s' "$reply" | jq -r '.sampleRate // 16000' >"$STATE/recording.rate"
  (umask 077 && echo "$id $owner $1" >"$STATE/$file.tmp" && mv "$STATE/$file.tmp" "$STATE/$file")
  : >"$STATE/alive.$id"
  # Hex drops a recording whose owner goes quiet for ten seconds. This stops when the recording
  # is finished or cancelled, and once the longest listen is over whatever happens.
  until=$((SECONDS + MAX_LISTEN_S + 10))
  (while [ -e "$STATE/alive.$id" ] && [ "$SECONDS" -lt "$until" ]; do
    sleep "$HEARTBEAT_S"
    [ -e "$STATE/alive.$id" ] && HEX_OWNER="$owner" hex POST "/dictations/$id/heartbeat" --max-time 3 >/dev/null
  done) &
}

hex_end() { # finish|cancel, id, owner -> prints the transcript for finish
  local reply
  rm -f "$STATE/alive.$2"
  reply=$(HEX_OWNER="$3" hex POST "/dictations/$2/$1" --max-time 60) || return 1
  [ "$1" = finish ] && printf '%s' "$reply" | jq -r '.transcript // empty' 2>/dev/null
}

# Returns when the speaker has stopped, and prints why with what it measured. The microphone
# level Hex reports is judged against the room, so a loud room or another microphone needs no
# setting:
# - the room level is the lowest "quietest tenth" seen so far. Talking cannot raise it, however
#   long it goes on. Only eight seconds with nothing near it can: then the room itself got
#   louder, and the level is taken again from those eight seconds;
# - a sample is loud when it stands 10 dB above the room. A real room wanders by several dB
#   and throws the odd louder instant, so quiet is "nothing loud", not "everything low";
# - speech is eight loud samples within a second: a click or a creak is fewer;
# - it ends when speech was heard and nothing loud followed for END_OF_SPEECH_S. There is no
#   limit on how long the speech may be. It also ends when nothing was said for NO_SPEECH_S,
#   when the stop file appears (the key again), and after MAX_LISTEN_S as a backstop.
# The first half second is left out: Hex reports near-total silence while the microphone opens.
wait_for_end_of_speech() { # id, owner
  # With the speech model installed, turn_end.py decides from the audio itself. The level rule
  # below is for when it gives no verdict: it is not installed, it failed to run, or this Hex
  # has no audio stream.
  local why
  if [ -x "$TURN_END/venv/bin/python" ]; then
    why=$(HEX_OWNER="$2" hex GET "/dictations/$1/audio" -N --max-time "$((MAX_LISTEN_S + 5))" |
      "$TURN_END/venv/bin/python" "$TURN_END/turn_end.py" --models "$TURN_END/models" \
        --rate "$(cat "$STATE/recording.rate")" --stop-file "$STATE/listening.stop" \
        --max-s "$MAX_LISTEN_S" --nothing-said-s "$NO_SPEECH_S" 2>>"$LOG")
    case "$why" in "" | "stream ended"*) log "turn_end.py gave no verdict: ${why:-it did not run}" ;; *)
      : >"$STATE/listening.heard" # turn_end.py works here, so it can listen on during the reply
      echo "$why"
      return
      ;;
    esac
  fi
  HEX_OWNER="$2" hex GET "/dictations/$1/levels" -N --max-time "$MAX_LISTEN_S" |
    END_S="$END_OF_SPEECH_S" NONE_S="$NO_SPEECH_S" MAX_S="$MAX_LISTEN_S" STOP_FILE="$STATE/listening.stop" \
      perl -MTime::HiRes=time -MIO::Select -e '
      $start = time; $buffer = "";
      $input = IO::Select->new(\*STDIN);
      sub tenth { my @sorted = sort { $a <=> $b } @_; $sorted[int($#sorted * 0.1)] }
      sub done {
        printf "%s (%d samples, room %s dB, loudest %s dB, %d loud)\n", $_[0], scalar(@level),
          defined $floor ? sprintf("%.0f", $floor) : "-", defined $loudest ? sprintf("%.0f", $loudest) : "-",
          scalar(@loud);
        exit 0;
      }
      while (1) {
        $now = time;
        done("key") if -e $ENV{STOP_FILE};
        # Quiet counts from the last loud sample, and never from before speech was recognised.
        $since = $speech ? ($last_loud > $speech_at ? $last_loud : $speech_at) : 0;
        done("quiet") if $speech && $now - $since >= $ENV{END_S};
        done("nothing said") if !$speech && $now - $start >= $ENV{NONE_S};
        done("limit") if $now - $start >= $ENV{MAX_S};
        next unless $input->can_read(0.2);       # also wakes with no sample, for the checks above
        sysread(STDIN, $chunk, 8192) or done("stream ended");
        $buffer .= $chunk;
        while ($buffer =~ s/^(.*?)\n//) {
          next unless $1 =~ /"rmsDb":\s*(-?[\d.]+)/;
          $now = time;
          next if $now - $start < 0.5;
          push @level, $1; push @at, $now;
          $loudest = $1 if !defined $loudest || $1 > $loudest;
          next if @level < 20;                    # a tenth of fewer would be one stray sample
          $low = tenth(@level);
          $floor = $low, $near = $now if !defined $floor || $low < $floor;
          $near = $now if $1 <= $floor + 3;
          if ($now - $near >= 8) {                # nothing near the room level: the room moved
            @keep = grep { $now - $at[$_] <= 8 } 0 .. $#level;
            @level = @level[@keep]; @at = @at[@keep];     # what came before no longer describes it
            $floor = tenth(@level);
            $near = $now;
          }
          # Judged again from the start each time: the room level may have just changed.
          @loud = map { $at[$_] } grep { $level[$_] >= $floor + 10 } 0 .. $#level;
          $last_loud = $loud[-1];
          next if $speech;
          for $i (7 .. $#loud) { $speech = 1 if $loud[$i] - $loud[$i - 7] <= 1 }
          $speech_at = $now if $speech;
        }
      }'
}

# Someone who only paused may go on talking while the reply is being made. Until her first
# audio plays he has not been answered, so listening carries on in a second recording: speech
# claims the turn back (the reply is dropped, and what he adds joins what he said), and the
# reply's first audio ends the listening. `mkdir "$dir/claim"` decides between the two.
# Prints why the listening ended: "key" when the reply began to play, else as a turn ends.
listen_on() { # turn dir, id, owner
  HEX_OWNER="$3" hex GET "/dictations/$2/audio" -N --max-time "$((MAX_LISTEN_S + 5))" |
    "$TURN_END/venv/bin/python" "$TURN_END/turn_end.py" --models "$TURN_END/models" \
      --rate "$(cat "$STATE/recording.rate")" --claim "$1/claim" --stop-file "$1/claim/speaking" \
      --stop-file "$STATE/listening.stop" --max-s "$MAX_LISTEN_S" --nothing-said-s "$MAX_LISTEN_S" 2>>"$LOG"
}

# Drops the recording that listened on, if one is open.
stop_listening_on() {
  local id owner
  [ -s "$STATE/listening-on" ] || return 0
  read -r id owner _ <"$STATE/listening-on"
  rm -f "$STATE/listening-on"
  hex_end cancel "$id" "$owner"
}

# Runs beside one reply, from the moment its request is on its way: opens the second recording
# and listens on. If he goes on talking, the request is dropped at once and the head is told to
# stop making the reply, and from then a double tap means "that's it" again. If the reply
# begins to play instead, the recording is dropped there and then, so the microphone is free.
listen_beside() { # turn dir, conversation id
  local dir="$1" id owner file until=$((SECONDS + MAX_LISTEN_S + 200))
  rm -f "$STATE/listening.stop"
  hex_start "$(now_ms)" listening-on || return 0
  read -r id owner _ <"$STATE/listening-on"
  echo "$id $owner" >"$dir/listening-on"
  (
    # Whoever takes the claim marks it at once: wait for the mark, not only the directory.
    while [ ! -e "$dir/claim/resumed" ] && [ ! -e "$dir/claim/speaking" ] && [ "$SECONDS" -lt "$until" ] && kill -0 $$ 2>/dev/null; do
      sleep 0.05
    done
    [ -e "$dir/claim/resumed" ] || exit 0
    log "he went on talking: the reply is dropped"
    echo $$ >"$STATE/listening.pid"
    # shellcheck disable=SC2046
    kill $(pgrep -P "$(cat "$dir/request.pid" 2>/dev/null)" 2>/dev/null) 2>/dev/null
    file=$(body '{heard_text: ""}')
    api "/v1/conversations/$2/interrupt" "$file" --max-time 10 >/dev/null 2>&1
    rm -f "$file"
  ) &
  listen_on "$dir" "$id" "$owner" >"$dir/listened.part"
  mv "$dir/listened.part" "$dir/listened"
  [ -e "$dir/claim/resumed" ] || stop_listening_on
}

body() { # jq filter, jq args... -> path of a JSON body file
  local file
  file=$(mktemp "$STATE/body.XXXXXX")
  jq -n "$@" >"$file"
  echo "$file"
}

# True when the pid file names a live janet-talk process, not a stranger that reused the number.
ours() { # pid file
  local pid
  [ -s "$1" ] || return 1
  pid=$(cat "$1")
  case "$(ps -p "$pid" -o command= 2>/dev/null)" in *janet-talk*) return 0 ;; esac
  return 1
}

# --- conversation -----------------------------------------------------------------

conversation_fresh() {
  [ -s "$STATE/conversation" ] && [ -s "$STATE/conversation.used" ] &&
    [ $(($(date +%s) - $(cat "$STATE/conversation.used"))) -lt "$CONVERSATION_IDLE_S" ]
}

open_conversation() {
  local file id
  if conversation_fresh; then return 0; fi
  rm -f "$STATE/conversation"
  file=$(body '{channel: $c, tier: "personal", client_ref: $r}' --arg c "$CHANNEL" --arg r "mac-$(now_ms)-$$")
  id=$(api /v1/conversations "$file" --max-time 20 | jq -r '.id // empty' 2>/dev/null)
  rm -f "$file"
  [ -n "$id" ] || {
    log "open failed"
    return 1
  }
  date +%s >"$STATE/conversation.used"
  echo "$id" >"$STATE/conversation.tmp" && mv "$STATE/conversation.tmp" "$STATE/conversation"
  log "opened $id"
}

end_conversation() { # reason
  local id file
  [ -s "$STATE/conversation" ] || return 0
  id=$(cat "$STATE/conversation")
  rm -f "$STATE/conversation" "$STATE/conversation.used"
  file=$(body '{reason: $v}' --arg v "$1")
  api "/v1/conversations/$id/end" "$file" --max-time 30 >/dev/null 2>&1
  rm -f "$file"
}

# --- media --------------------------------------------------------------------------
# Whatever the Mac is playing (a show in a browser, Spotify, anything that reports to Now
# Playing) is paused while Janet speaks and resumed after, but only when it was playing.
# macOS 15.4 closed MediaRemote to ordinary programs, so this goes through the entitled
# /usr/bin/perl and the mediaremote-adapter that install.sh builds. JANET_TALK_MEDIA names a
# stand-in for it. The adapter's `send` takes a command id, not a name: 1 is pause and 0 is play.

media() { # adapter arguments...; gives up on a call that hangs
  if [ -n "${JANET_TALK_MEDIA:-}" ]; then
    perl -e 'alarm shift; exec @ARGV' "$MEDIA_TIMEOUT_S" "$JANET_TALK_MEDIA" "$@"
  elif [ -r "$MEDIA_DIR/bin/mediaremote-adapter.pl" ]; then
    perl -e 'alarm shift; exec @ARGV' "$MEDIA_TIMEOUT_S" /usr/bin/perl "$MEDIA_DIR/bin/mediaremote-adapter.pl" \
      "$MEDIA_DIR/build/MediaRemoteAdapter.framework" "$@"
  else
    return 1
  fi
}

media_playing() { # prints the bundle id of what is playing, and fails when nothing is
  local now
  now=$(media get --no-artwork 2>/dev/null) || return 1
  [ "$(printf '%s' "$now" | jq -r '.playing // false' 2>/dev/null)" = true ] || return 1
  printf '%s' "$now" | jq -r '.bundleIdentifier // empty'
}

media_pause() {
  local bundle
  bundle=$(media_playing) || return 0
  media send 1 >/dev/null 2>&1 || return 0
  printf '%s %s' "$(date +%s)" "$bundle" >"$STATE/media.paused"
  log "media paused: $bundle"
}

# Resumes what media_pause stopped, once. The file is claimed by renaming it, so the end of a
# reply and a barge-in cannot both resume. Something the listener started in between is left alone.
media_resume() {
  local claim="$STATE/media.resuming.$$" bundle paused_at
  mv "$STATE/media.paused" "$claim" 2>/dev/null || return 0
  read -r paused_at bundle <"$claim"
  rm -f "$claim"
  case "$paused_at" in "" | *[!0-9]*) return 0 ;; esac
  [ $(($(date +%s) - paused_at)) -lt "$MEDIA_STALE_S" ] || return 0
  media_playing >/dev/null && return 0
  [ "$(media get --no-artwork 2>/dev/null | jq -r '.bundleIdentifier // empty' 2>/dev/null)" = "$bundle" ] || return 0
  media send 0 >/dev/null 2>&1
  log "media resumed: $bundle"
}

# --- speech -----------------------------------------------------------------------

# Fetches one sentence's audio. The voice host may be asleep: the gateway then answers 503
# after sending a wake packet, and this keeps asking until the voice is up or time runs out.
# Any other failure, such as a transfer the gateway cut because the voice failed, is final.
fetch_speech() { # turn dir, index
  local dir="$1" i="$2" file code="" deadline announced=""
  file=$(body '{text: $v}' --arg v "$(cat "$dir/$i.txt")")
  deadline=$(($(date +%s) + VOICE_WAKE_WAIT_S))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if code=$(api /v1/tts "$file" --max-time 300 -o "$dir/$i.part" -w '%{http_code}'); then
      if [ "$code" = 200 ] && [ -s "$dir/$i.part" ]; then
        mv "$dir/$i.part" "$dir/$i.wav"
        break
      fi
    fi
    log "speech $i: http $code"
    # 503 is a sleeping voice host and 000 is no answer at all; both are worth another try.
    [ "$code" = 503 ] || [ "$code" = 000 ] || break
    if [ "$code" = 503 ] && [ -z "$announced" ] && [ "$i" = 1 ]; then
      announced=1
      notify "Janet" "Waking the voice PC. I'll speak as soon as it's up."
    fi
    sleep "$RETRY_S"
  done
  if [ ! -e "$dir/$i.wav" ]; then
    : >"$dir/$i.failed"
    # Out of time with the host still down: the rest of the reply would wait just as long.
    [ "$code" = 503 ] || [ "$code" = 000 ] && : >"$dir/voice-down"
  fi
  rm -f "$file" "$dir/$i.part"
}

# Synthesizes the reply's sentences one at a time, in order, as they arrive. The voice server
# works through requests one by one, so asking for all of them at once only lets a later
# sentence take the turn of an earlier one. This way the first sentence is always ready first,
# and each next one is being made while the one before it plays.
fetch_turn() { # turn dir
  local dir="$1" i=1
  while [ ! -e "$dir/claim/resumed" ]; do
    if [ -e "$dir/$i.txt" ]; then
      if [ -e "$dir/voice-down" ]; then : >"$dir/$i.failed"; else fetch_speech "$dir" "$i"; fi
      i=$((i + 1))
    elif [ -e "$dir/count" ] && [ "$i" -gt "$(cat "$dir/count")" ]; then
      break
    else
      sleep 0.05
    fi
  done
}

# Plays sentences in order as their audio arrives. Stops after the last one.
play_turn() { # turn dir
  local dir="$1" i=1 deadline=$((SECONDS + VOICE_WAKE_WAIT_S + 600))
  sh -c 'echo $PPID' >"$dir/player.pid"
  while [ "$SECONDS" -lt "$deadline" ] && [ ! -e "$dir/claim/resumed" ]; do
    if [ -e "$dir/$i.wav" ]; then
      # The first sentence may have failed, so this is the first one that plays.
      [ -e "$dir/media" ] || {
        # From here he is being answered. If he went on talking first, nothing plays.
        mkdir "$dir/claim" 2>/dev/null || return 0
        : >"$dir/claim/speaking"
        log "first audio"
        : >"$dir/media"
        media_pause
      }
      afplay "$dir/$i.wav"
      echo "$i" >"$dir/played"
      i=$((i + 1))
    elif [ -e "$dir/$i.failed" ]; then
      i=$((i + 1))
    elif [ -e "$dir/count" ] && [ "$i" -gt "$(cat "$dir/count")" ]; then
      break
    else
      sleep 0.05
    fi
  done
  # A reply with nothing to play is over too: nothing is left to claim back.
  mkdir "$dir/claim" 2>/dev/null && : >"$dir/claim/speaking"
  media_resume
}

# Stops a reply that is still being fetched or played. Prints the directory of the stopped turn.
stop_reply() {
  local dir turn player playing fetching
  ours "$STATE/turn.pid" || return 1
  turn=$(cat "$STATE/turn.pid")
  dir=$(cat "$STATE/turn.dir" 2>/dev/null)
  player=$(cat "$dir/player.pid" 2>/dev/null)
  # The player goes first, so it cannot move on to the next sentence when its afplay dies.
  playing=$([ -n "$player" ] && pgrep -P "$player")
  fetching=$(pgrep -P "$turn")
  # shellcheck disable=SC2086
  kill "$turn" $player $playing $fetching 2>/dev/null
  rm -f "$STATE/turn.pid"
  echo "$dir"
}

# Tells the head which sentences of the stopped reply were heard in full.
report_heard() { # turn dir
  local dir="$1" played heard="" i=1 file id
  [ -n "$dir" ] && [ -s "$STATE/conversation" ] || return 0
  played=$(cat "$dir/played" 2>/dev/null || echo 0)
  while [ "$i" -le "$played" ]; do
    heard="$heard$(cat "$dir/$i.txt") "
    i=$((i + 1))
  done
  id=$(cat "$STATE/conversation")
  file=$(body '{heard_text: $v}' --arg v "${heard% }")
  api "/v1/conversations/$id/interrupt" "$file" --max-time 10 >/dev/null 2>&1
  rm -f "$file"
  log "barge-in after $played sentences"
}

# --- the two key events -------------------------------------------------------------

start() {
  local warm stopped id owner pressed
  pressed=$(now_ms)
  [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 1000000 ] && : >"$LOG"
  log "start"
  # While Janet is listening after a double tap, another double tap means "that's it".
  if ours "$STATE/listening.pid"; then
    : >"$STATE/listening.stop"
    log "listening ended by the key"
    exit 0
  fi
  # The microphone comes first: nothing below may delay the recording.
  stopped=$(stop_reply)
  stop_listening_on # Hex records one thing at a time
  # A conversation gone stale leaves the file: `stop` then knows one is being opened below.
  conversation_fresh || rm -f "$STATE/conversation"
  media_resume &
  hex_start "$pressed" || {
    notify "Janet" "Hex is not running."
    exit 1
  }
  if ! load_secrets; then
    read -r id owner _ <"$STATE/recording"
    rm -f "$STATE/recording"
    hex_end cancel "$id" "$owner"
    notify "Janet" "Not set up: run the janet-mac install script."
    exit 1
  fi
  [ -n "$stopped" ] && report_heard "$stopped"
  # While Parker talks: get the conversation ready and start the voice loading.
  open_conversation
  warm=$(body '{text: "Hi."}')
  api /v1/tts "$warm" --max-time 300 -o /dev/null >/dev/null 2>&1
  rm -f "$warm"
}

stop() {
  local released text status id dir file count=0 event="" line end="false" reply="" waited=0
  local hex_id hex_owner pressed why listened="" passes=0 on_id on_owner more jobs busy busy_tries=0
  released=$(now_ms)
  log "released"
  # A quick tap can run this before `start` has begun the recording. Wait for it, briefly.
  while [ ! -e "$STATE/recording" ] && [ "$waited" -lt 20 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  [ -e "$STATE/recording" ] || {
    log "no recording to end"
    exit 0
  }
  read -r hex_id hex_owner pressed <"$STATE/recording"
  case "${pressed:-}" in "" | *[!0-9]*) pressed=0 ;; esac
  # A release whose own press never started a recording must not end a later press's one.
  if [ "$pressed" -gt "$released" ]; then
    log "the recording belongs to a later press"
    exit 0
  fi
  rm -f "$STATE/recording"
  if [ $((released - pressed)) -lt "$LATCH_MS" ]; then
    # A tap, not a hold: listen until the speaker stops.
    rm -f "$STATE/listening.stop" "$STATE/listening.heard"
    echo $$ >"$STATE/listening.pid"
    log "listening"
    why=$(wait_for_end_of_speech "$hex_id" "$hex_owner")
    rm -f "$STATE/listening.pid"
    released=$(now_ms)
    [ -e "$STATE/listening.heard" ] && listened=1
    log "stopped listening: ${why:-no level stream}"
  fi
  text=$(hex_end finish "$hex_id" "$hex_owner")
  status=$?
  text=$(printf '%s' "$text" | tr '\n' ' ' | sed 's/^ *//; s/ *$//')
  log "transcript status $status after $(($(now_ms) - released)) ms"
  if [ "$status" -ne 0 ] || [ -z "$text" ]; then
    notify "Janet" "Didn't catch that."
    exit 0
  fi
  load_secrets || exit 1
  # `start` may still be opening the conversation: then there is none on file yet. One that is
  # on file and has gone stale (he talked for over a minute and a half) is not worth waiting for.
  waited=0
  while ! conversation_fresh && [ ! -s "$STATE/conversation" ] && [ "$waited" -lt 100 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  conversation_fresh || open_conversation || {
    notify "Janet" "Can't reach Janet."
    exit 1
  }
  id=$(cat "$STATE/conversation")

  # One pass sends what was said and speaks the reply. Another follows each time he goes on
  # talking before the reply has begun to play.
  while :; do
    dir=$(mktemp -d "$STATE/turn.XXXXXX")
    echo "$dir" >"$STATE/turn.dir"
    echo $$ >"$STATE/turn.pid"
    count=0 event="" end="false" reply="" jobs="" busy=""
    # The request goes first, and its answer is opened at once: nothing below may delay the reply.
    file=$(body '{text: $v}' --arg v "$text")
    mkfifo "$dir/events"
    api "/v1/conversations/$id/turns" "$file" -N --max-time 180 >"$dir/events" &
    echo $! >"$dir/request.pid"
    exec 3<"$dir/events"
    play_turn "$dir" 3<&- &
    jobs="$jobs $!"
    fetch_turn "$dir" 3<&- &
    jobs="$jobs $!"
    if [ -n "$listened" ] && [ "$passes" -lt "$MAX_RESUMES" ]; then
      listen_beside "$dir" "$id" 3<&- &
      jobs="$jobs $!"
    fi
    # A refusal is one line with no newline after it: it is read too.
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      case "$line" in
        "") event="" ;;
        event:*) event=$(echo "${line#event:}" | tr -d ' ') ;;
        data:*)
          if [ "$event" = sentence ]; then
            count=$((count + 1))
            [ "$count" = 1 ] && log "first sentence after $(($(now_ms) - released)) ms"
            printf '%s' "${line#data:}" | jq -r .text >"$dir/$count.part"
            mv "$dir/$count.part" "$dir/$count.txt"
            reply="$reply$(cat "$dir/$count.txt") "
          elif [ "$event" = done ]; then
            end=$(printf '%s' "${line#data:}" | jq -r .end_conversation)
          fi
          ;;
        *"already in flight"*) busy=1 ;;
      esac
    done <&3
    exec 3<&-
    rm -f "$file"
    echo "$count" >"$dir/count"
    date +%s >"$STATE/conversation.used"
    if [ -e "$dir/claim/resumed" ]; then
      : # the reply was dropped: nothing to show
    elif [ -n "$busy" ] && [ "$passes" -gt 0 ] && [ "$busy_tries" -lt 30 ]; then
      : # the head is still putting the dropped reply away: what he said is sent again below
    elif [ "$count" = 0 ]; then
      notify "Janet" "Can't reach Janet."
      rm -f "$STATE/conversation" "$STATE/conversation.used"
    else
      notify "Janet" "${reply% }"
    fi
    # Not a bare `wait`: the second recording's keep-alive is a job too, and runs on.
    # shellcheck disable=SC2086
    wait $jobs
    rm -f "$STATE/listening.pid"
    if [ ! -e "$dir/claim/resumed" ]; then
      [ -n "$busy" ] && [ "$passes" -gt 0 ] && [ "$busy_tries" -lt 30 ] || break
      busy_tries=$((busy_tries + 1))
      log "the head was not ready for what he added: sending it again"
      sleep 1
      continue
    fi
    # He went on: what he added joins what he said, and the whole of it is sent again.
    read -r on_id on_owner <"$dir/listening-on"
    rm -f "$STATE/listening-on"
    released=$(now_ms)
    log "stopped listening again: $(cat "$dir/listened" 2>/dev/null)"
    more=$(hex_end finish "$on_id" "$on_owner" | tr '\n' ' ' | sed 's/^ *//; s/ *$//')
    [ -n "$more" ] && text="$text $more"
    passes=$((passes + 1))
    conversation_fresh || open_conversation || {
      notify "Janet" "Can't reach Janet."
      break
    }
    id=$(cat "$STATE/conversation")
  done
  [ "$end" = true ] && [ ! -e "$dir/claim/resumed" ] && end_conversation end_phrase
  log "done after $(($(now_ms) - released)) ms"
  rm -f "$STATE/turn.pid"
  find "$STATE" -maxdepth 1 -name 'turn.*' -type d -mmin +10 -exec rm -rf {} + 2>/dev/null
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  end) load_secrets && end_conversation client_exit ;;
  *)
    echo "usage: janet-talk start|stop|end" >&2
    exit 2
    ;;
esac
