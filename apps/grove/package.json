{
	"name": "@petalnet/grove",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build && node ../../tools/verify-grove-production-boundary.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"migrate": "effectdb migrate up",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"@effect/sql-pg": "catalog:",
		"@lucide/svelte": "catalog:prod",
		"@petalnet/better-auth-effect-qb-adapter": "workspace:*",
		"@petalnet/effect-api": "workspace:*",
		"@petalnet/effect-sveltekit": "workspace:*",
		"@sveltejs/kit": "catalog:",
		"better-auth": "catalog:",
		"daisyui": "catalog:prod",
		"effect": "catalog:",
		"effect-db": "catalog:",
		"effect-qb": "catalog:",
		"jose": "catalog:",
		"mode-watcher": "catalog:",
		"svelte": "catalog:prod",
		"tailwindcss": "catalog:prod"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "catalog:dev",
		"@sveltejs/vite-plugin-svelte": "catalog:dev",
		"@tailwindcss/vite": "catalog:dev",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:types",
		"svelte-check": "catalog:dev",
		"typescript": "catalog:dev",
		"vite": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"dependenciesMeta": {
		"@petalnet/better-auth-effect-qb-adapter": {
			"injected": true
		}
	}
}
