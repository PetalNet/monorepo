{
	"name": "@petalnet/grove",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build && node ../../tools/verify-grove-production-boundary.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"migrate": "node migrations/runner.ts up",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"@effect/sql-pg": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@better-auth/mcp": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@lucide/svelte": "catalog:prod",
		"@petalnet/effect-api": "workspace:*",
		"@petalnet/effect-sveltekit": "workspace:*",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:dev",
		"@tailwindcss/vite": "catalog:dev",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:types",
		"better-auth": "catalog:",
		"daisyui": "catalog:prod",
		"drizzle-kit": "catalog:",
		"drizzle-orm": "catalog:",
		"fontless": "catalog:",
		"jose": "catalog:",
		"mode-watcher": "catalog:",
		"svelte": "catalog:prod",
		"svelte-check": "catalog:dev",
		"tailwindcss": "catalog:prod",
		"typescript": "catalog:dev",
		"vite": "catalog:dev",
		"vitest": "catalog:dev"
	}
}
