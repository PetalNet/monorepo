#!/usr/bin/env bash
set -euo pipefail

curl https://mise.run | sh
# Use shims so repo-managed tools propagate to child processes.
eval "$(~/.local/bin/mise activate --shims bash)"

mise trust --yes mise.toml
mise install --yes --locked pnpm

# Older orb snapshots sourced Vite+ after Mise, overriding its Node shim.
for profile in "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.profile"; do
	if [[ -f "$profile" ]]; then
		sed -i '\|^# Vite+ bin (https://viteplus.dev)$|d; \|^\. "$HOME/\.vite-plus/env"$|d' "$profile"
	fi
done

# Activate after Amp's environment hook, which can restore an older PATH.
if [[ -f "$HOME/.bash_profile" ]]; then
	sed -i '\|^eval "\$("\$HOME/\.local/bin/mise" activate --shims bash)"$|d' "$HOME/.bash_profile"
fi
cat >> "$HOME/.bash_profile" <<'EOF_PROFILE'
eval "$("$HOME/.local/bin/mise" activate --shims bash)"
EOF_PROFILE

pnpm install --frozen-lockfile

if ! gh extension list | grep -q '^gh stack[[:space:]]'; then
	gh extension install github/gh-stack
fi

if ! command -v docker >/dev/null 2>&1; then
	sudo apt-get update -q
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q docker.io
fi
if ! sudo docker info >/dev/null 2>&1; then
	amp orb service start docker --command 'sudo dockerd --host=unix:///var/run/docker.sock'
	for _ in {1..30}; do
		sudo docker info >/dev/null 2>&1 && break
		sleep 1
	done
	sudo docker info >/dev/null
fi
sudo chmod 666 /var/run/docker.sock

amp_config_dir="$HOME/.config/amp"
mkdir -p "$amp_config_dir"
cat > "$amp_config_dir/AGENTS.md" <<'EOF_AGENTS'
# Inside the PetalNet Orb

- This orb may have older system Node.js and pnpm versions; .agents/setup activates Mise for repo-managed tools.
- Mise installs pnpm; pnpm installs the Node runtime pinned in package.json. Use `pnpm exec node` for standalone Node commands.
- Run repository workflows with `pnpm check`, `pnpm test`, and `pnpm build`; turbo.json owns the cache policy.
- Install missing tools with `mise install --locked <tool>`, then run the command directly. Do not use `mise exec`, `mise x`, or `mise activate &&`.
- Rust is lazy: run `mise install --locked rust` from the repository root; the root `rust-toolchain.toml` pins the shared Cargo workspace and standalone Point Flutter bridge toolchain.
- Flutter is lazy: from a Flutter app directory, run `mise install --locked flutter`, then `flutter pub get`.
- Docker runs as the supervised `docker` Amp service for Testcontainers.
- For Grove development, run `.agents/ensure-grove` from the repository root, then follow `apps/grove/AGENTS.md` and the public URLs in its JSON output.

## Stacked pull requests

- The `github/gh-stack` extension is installed as `gh stack`. Use it when a change is best reviewed as a linear series of dependent PRs; keep foundational work at the bottom and dependent work at the top.
- Keep the workflow non-interactive: start or adopt branches from bottom to top with `gh stack init <bottom> [<next>...]`, add a layer with `gh stack add <branch>`, inspect with `gh stack view --json`, and navigate with explicit arguments or `gh stack up`, `down`, `top`, and `bottom`.
- Commit each layer on its own branch. After changing a lower layer, run `gh stack rebase --upstack` to restack its descendants. Use `gh stack rebase`, then `gh stack rebase --continue` or `--abort`, for conflicts.
- After receiving approval to push, use `gh stack submit --auto` to push and create or update draft PRs, or add `--open` to make them ready for review. Use `gh stack sync` for an existing remote stack; it fetches, rebases, pushes, and updates stack metadata, but never creates PRs.
- `submit`, `sync`, and `push` change remote branches. Always ask the user before running them. With multiple remotes, pass `--remote <name>` explicitly.
EOF_AGENTS
