#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

for command in amp curl jq; do
	command -v "$command" >/dev/null 2>&1 || {
		printf 'Grove ensure requires %s\n' "$command" >&2
		exit 127
	}
done

mkdir -p .amp/in
services=$(amp orb services ensure --json)

grove_manifest=.amp/portals/grove.json
oidc_manifest=.amp/portals/grove-oidc.json
for manifest in "$grove_manifest" "$oidc_manifest"; do
	[[ -s "$manifest" ]] || {
		printf 'Grove portal manifest is missing: %s\n' "$manifest" >&2
		exit 1
	}
done

grove_portal=$(jq -er '.links[0].url | rtrimstr("/")' "$grove_manifest")
oidc_portal=$(jq -er '.links[0].url | rtrimstr("/")' "$oidc_manifest")
preflight=$(curl --fail-with-body --silent --show-error "$grove_portal/__dev/preflight")
preflight_status=$(jq -er '.status' <<<"$preflight")

jq -n \
	--arg status "$preflight_status" \
	--arg grovePortal "$grove_portal" \
	--arg oidcPortal "$oidc_portal" \
	--argjson services "$services" \
	--argjson preflight "$preflight" \
	'{
		status: $status,
		grovePortal: $grovePortal,
		oidcPortal: $oidcPortal,
		portalManifests: {
			grove: ".amp/portals/grove.json",
			oidc: ".amp/portals/grove-oidc.json"
		},
		services: $services,
		preflight: $preflight
	}'

[[ "$preflight_status" == ready ]]
