{
	"$schema": "https://turborepo.dev/schema.json",
	"agentGuidance": false,
	"futureFlags": {
		"experimentalCargoWorkspaces": true,
		"experimentalTaskCommand": true
	},
	"globalPassThroughEnv": [
		"PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN",
		"CARGO_INCREMENTAL",
		"CI",
		"DATABASE_URL",
		"*_DATABASE_URL",
		"BETTER_AUTH_*",
		"GROVE_*",
		"OIDC_*",
		"OTEL_*",
		"SENTRY_*",
		"ORIGIN",
		"ADMIN_EMAIL",
		"PORT"
	],
	"globalDependencies": [
		"*",
		"!.git",
		"!.env",
		"!.env.*",
		"!*.log",
		".github/workflows/ci.yml",
		".github/workflows/point.yml",
		".github/actions/**",
		"tools/**",
		"!tools/node_modules/**",
		"!tools/.turbo/**",
		"!tools/coverage/**",
		"packages/**",
		"!packages/**/node_modules/**",
		"!packages/**/dist/**",
		"!packages/**/.turbo/**",
		"!packages/**/coverage/**",
		"!packages/**/.cache/**"
	],
	"globalEnv": ["NODE_ENV", "NODE_OPTIONS", "TZ", "PUBLIC_*", "VITE_*"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["!CARGO_INCREMENTAL"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"build/**",
				"dist/**",
				".svelte-kit/**",
				"!.svelte-kit/build/temp/**",
				"node_modules/.cache/tsbuild/**",
				"storybook-static/**"
			]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": ["dist/**", "node_modules/.cache/tsbuild/**"]
		},
		"@petalnet/storybook#typecheck": { "outputs": [] },
		"check": {
			"dependsOn": ["^typecheck", "prepare"],
			"env": ["!CARGO_INCREMENTAL"],
			"outputs": []
		},
		"@petalnet/better-auth-effect-qb-adapter#check": {
			"outputs": ["node_modules/.cache/tsbuild/**"]
		},
		"@petalnet/tools#check": { "cache": false },
		"prepare": { "cache": false },
		"generate": { "cache": false },
		"format": { "env": ["!CARGO_INCREMENTAL"] },
		"fmt:check": { "env": ["RUSTFMT"], "outputs": [] },
		"lint": { "env": ["!CARGO_INCREMENTAL"] },
		"test": {
			"cache": false,
			"env": ["!CARGO_INCREMENTAL"],
			"passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "XDG_RUNTIME_DIR"]
		},
		"@petalnet/collegemap#test": {
			"cache": true,
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": []
		},
		"@petalnet/effect-api#test": {
			"cache": true,
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": []
		},
		"@petalnet/effect-sveltekit#test": {
			"cache": true,
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": []
		},
		"petalnet-rust#check": { "dependsOn": [], "env": ["!CARGO_INCREMENTAL"] },
		"petalnet-rust#lint": {
			"env": ["!CARGO_INCREMENTAL"],
			"command": ["cargo", "clippy", "--workspace", "--all-targets", "--locked"]
		},
		"//#typecheck": {
			"dependsOn": [
				"@petalnet/ui#typecheck",
				"@petalnet/utils#typecheck",
				"@petalnet/types#typecheck"
			],
			"outputs": ["node_modules/.cache/tsbuild/**"]
		},
		"//#fmt:check": { "outputs": [] },
		"//#lint:oxlint": {
			"dependsOn": [
				"//#typecheck",
				"@petalnet/clarity-mcp#typecheck",
				"@petalnet/effect-api#typecheck",
				"@petalnet/effect-sveltekit#typecheck",
				"@petalnet/better-auth-effect-qb-adapter#check",
				"@petalnet/collegemap#check",
				"@petalnet/grove#check",
				"@petalnet/storybook#typecheck",
				"@petalnet/whoami#check"
			],
			"outputs": []
		},
		"//#lint:impeccable": { "outputs": [] },
		"//#manypkg": { "outputs": [] },
		"//#dedupe:check": { "cache": false },
		"//#typesync:check": { "cache": false },
		"//#lint:knip": {
			"dependsOn": ["//#lint:eslint:apps"],
			"outputs": []
		},
		"//#lint:knip:prod": {
			"dependsOn": ["//#lint:eslint:apps"],
			"outputs": []
		},
		"//#lint:eslint:apps": {
			"dependsOn": [
				"@petalnet/collegemap#check",
				"@petalnet/grove#check",
				"@petalnet/slide#check",
				"//#lint:eslint:root"
			],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		"//#lint:eslint:root": {
			"dependsOn": ["//#typecheck", "//#lint:oxlint"],
			"inputs": ["$TURBO_DEFAULT$", "!apps/**"],
			"outputs": []
		}
	}
}
