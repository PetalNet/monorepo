{
	"$schema": "https://turborepo.dev/schema.json",
	"agentGuidance": false,
	"futureFlags": {
		"experimentalCargoWorkspaces": true,
		"experimentalTaskCommand": true
	},
	"globalDependencies": [
		"*",
		"!.git",
		".env*",
		"apps/*/.env*",
		"tools/**",
		"packages/**",
		"!packages/**/node_modules/**",
		"!packages/**/dist/**",
		"!packages/**/.turbo/**",
		"!packages/**/coverage/**",
		"!packages/**/.cache/**"
	],
	"globalEnv": [
		"NODE_ENV",
		"NODE_OPTIONS",
		"TZ",
		"CI",
		"DATABASE_URL",
		"*_DATABASE_URL",
		"BETTER_AUTH_*",
		"GROVE_*",
		"PUBLIC_*",
		"VITE_*",
		"OIDC_*",
		"OTEL_*",
		"SENTRY_*",
		"ORIGIN",
		"ADMIN_EMAIL",
		"PORT"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"build/**",
				"dist/**",
				".svelte-kit/**",
				"!.svelte-kit/build/temp/**",
				"node_modules/.cache/tsbuild/**",
				"storybook-static/**"
			]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": ["dist/**", "node_modules/.cache/tsbuild/**"]
		},
		"@petalnet/storybook#typecheck": { "outputs": [] },
		"check": {
			"dependsOn": ["^typecheck", "prepare"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": []
		},
		"@petalnet/better-auth-effect-qb-adapter#check": {
			"outputs": ["node_modules/.cache/tsbuild/**"]
		},
		"prepare": { "cache": false },
		"generate": { "cache": false },
		"test": {
			"cache": false,
			"passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "XDG_RUNTIME_DIR"]
		},
		"@petalnet/collegemap#test": { "cache": true, "outputs": [] },
		"@petalnet/effect-api#test": { "cache": true, "outputs": [] },
		"@petalnet/effect-sveltekit#test": { "cache": true, "outputs": [] },
		"agent-manager#build": { "dependsOn": [], "outputs": [] },
		"box-agent#build": { "dependsOn": [], "outputs": [] },
		"control-plane#build": { "dependsOn": [], "outputs": [] },
		"courier#build": { "dependsOn": [], "outputs": [] },
		"courier-ai#build": { "dependsOn": [], "outputs": [] },
		"courier-core#build": { "dependsOn": [], "outputs": [] },
		"courier-plugins#build": { "dependsOn": [], "outputs": [] },
		"courier-relay#build": { "dependsOn": [], "outputs": [] },
		"dispatcher#build": { "dependsOn": [], "outputs": [] },
		"point-core#build": { "dependsOn": [], "outputs": [] },
		"point-server#build": { "dependsOn": [], "outputs": [] },
		"agent-manager#check": { "dependsOn": [] },
		"box-agent#check": { "dependsOn": [] },
		"control-plane#check": { "dependsOn": [] },
		"courier#check": { "dependsOn": [] },
		"courier-ai#check": { "dependsOn": [] },
		"courier-core#check": { "dependsOn": [] },
		"courier-plugins#check": { "dependsOn": [] },
		"courier-relay#check": { "dependsOn": [] },
		"dispatcher#check": { "dependsOn": [] },
		"point-core#check": { "dependsOn": [] },
		"point-server#check": { "dependsOn": [] },
		"petalnet-rust#check": { "dependsOn": [] },
		"agent-manager#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"agent-manager",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"box-agent#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"box-agent",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"control-plane#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"control-plane",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"courier#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"courier",
				"--all-targets",
				"--locked",
				"--",
				"-W",
				"clippy::pedantic",
				"-D",
				"warnings"
			]
		},
		"courier-ai#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"courier-ai",
				"--all-targets",
				"--locked",
				"--",
				"-W",
				"clippy::pedantic",
				"-D",
				"warnings"
			]
		},
		"courier-core#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"courier-core",
				"--all-targets",
				"--locked",
				"--",
				"-W",
				"clippy::pedantic",
				"-D",
				"warnings"
			]
		},
		"courier-plugins#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"courier-plugins",
				"--all-targets",
				"--locked",
				"--",
				"-W",
				"clippy::pedantic",
				"-D",
				"warnings"
			]
		},
		"courier-relay#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"courier-relay",
				"--all-targets",
				"--locked",
				"--",
				"-W",
				"clippy::pedantic",
				"-D",
				"warnings"
			]
		},
		"dispatcher#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"dispatcher",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"point-core#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"point-core",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"point-server#lint": {
			"command": [
				"cargo",
				"clippy",
				"-p",
				"point-server",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"petalnet-rust#lint": {
			"command": [
				"cargo",
				"clippy",
				"--workspace",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"agent-manager#test": { "cache": false, "passThroughEnv": ["N12_TMUX_IT"] },
		"//#typecheck": {
			"dependsOn": [
				"@petalnet/ui#typecheck",
				"@petalnet/utils#typecheck",
				"@petalnet/types#typecheck"
			],
			"outputs": ["node_modules/.cache/tsbuild/**"]
		},
		"//#fmt:check": { "outputs": [] },
		"//#lint:oxlint": { "outputs": [] },
		"//#lint:impeccable": { "outputs": [] },
		"//#manypkg": { "outputs": [] },
		"//#dedupe:check": { "cache": false },
		"//#typesync:check": { "cache": false },
		"//#lint:knip": {
			"dependsOn": ["//#lint:eslint:apps"],
			"outputs": []
		},
		"//#lint:knip:prod": {
			"dependsOn": ["//#lint:eslint:apps"],
			"outputs": []
		},
		"//#lint:eslint:apps": {
			"dependsOn": [
				"@petalnet/collegemap#check",
				"@petalnet/grove#check",
				"@petalnet/slide#check",
				"//#lint:eslint:root"
			],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		"//#lint:eslint:root": {
			"dependsOn": ["//#typecheck", "//#lint:oxlint"],
			"inputs": ["$TURBO_DEFAULT$", "!apps/**"],
			"outputs": []
		}
	}
}
