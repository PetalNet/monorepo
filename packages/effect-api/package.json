{
	"name": "@petalnet/effect-api",
	"version": "0.1.0",
	"private": true,
	"description": "Effect Schema operations exposed consistently as REST, OpenAPI, and MCP",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./better-auth": {
			"types": "./src/better-auth.ts",
			"default": "./src/better-auth.ts"
		}
	},
	"scripts": {
		"coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.thresholds.100",
		"test": "vitest run",
		"typecheck": "tsc -b && tsc -p test/tsconfig.json"
	},
	"dependencies": {
		"effect": "catalog:"
	},
	"devDependencies": {
		"@better-auth/mcp": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@petalnet/tsconfig": "workspace:*",
		"@vitest/coverage-v8": "catalog:dev",
		"typescript": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"peerDependencies": {
		"@better-auth/mcp": "catalog:"
	},
	"peerDependenciesMeta": {
		"@better-auth/mcp": {
			"optional": true
		}
	}
}
