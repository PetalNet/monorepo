{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"allowArbitraryExtensions": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"composite": true,
		"skipLibCheck": true,
		"tsBuildInfoFile": "${configDir}/node_modules/.cache/tsbuild/info.json",
		"declaration": true,
		"declarationMap": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"allowUnreachableCode": false,
		"erasableSyntaxOnly": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnostics": false,
				"allowedUnstableApis": [
					"effect/http",
					"effect/ai",
					"effect/sql",
					"effect/http-api/HttpApiScalar",
					"effect/http-api/HttpApi#make",
					"effect/http-api/HttpApiBuilder#group",
					"effect/http-api/HttpApiBuilder#layer",
					"effect/http-api/HttpApiEndpoint#make",
					"effect/http-api/HttpApiError#HttpApiSchemaError",
					"effect/http-api/HttpApiGroup#make",
					"effect/http-api/HttpApiGroup#HttpApiGroup",
					"effect/http-api/HttpApiMiddleware#Service",
					"effect/http-api/OpenApi#fromApi",
					"effect/http-api/OpenApi#Description",
					"effect/http-api/OpenApi#Title",
					"effect/http-api/OpenApi#Version"
				]
			}
		]
	}
}
