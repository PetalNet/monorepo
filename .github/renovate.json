{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		"preview:dockerCompose",
		"preview:dockerVersions",
		":automergeAll",
		":disableRateLimiting",
		":pinAllExceptPeerDependencies",
		":preserveSemverRanges",
		":semanticCommits"
	],
	"postUpdateOptions": ["pnpmDedupe"],
	"minimumReleaseAge": "7 days",
	"labels": ["dependencies"],
	"automergeStrategy": "squash",
	"packageRules": [
		{
			"description": "OkHttp 5.5 requires compileSdk 37 and apps/janet-call-android compiles against 35; #705 broke its build. Lift this with the compileSdk bump.",
			"matchPackageNames": ["com.squareup.okhttp3:okhttp"],
			"allowedVersions": "<5"
		},
		{
			"description": "Compose BOM 2026 (compose 1.12) needs Android Gradle plugin 9.1 and a newer compileSdk, so #742 broke the build of apps/janet-call-android. Lift this with the plugin and compileSdk bump.",
			"matchPackageNames": ["androidx.compose:compose-bom"],
			"allowedVersions": "<2026"
		},
		{
			"description": "One Node.js everywhere: devEngines, every Dockerfile FROM node:, and @types/node move in a single PR that automerges. recreateWhen always keeps a branch whose update was already merged (by hand or by an earlier PR) from being stranded with automerge disabled.",
			"matchDatasources": ["node-version", "docker"],
			"matchPackageNames": ["node"],
			"groupName": "node.js",
			"automerge": true,
			"recreateWhen": "always"
		},
		{
			"matchDatasources": ["npm"],
			"matchPackageNames": ["@types/node"],
			"groupName": "node.js",
			"automerge": true,
			"recreateWhen": "always"
		},
		{
			"matchPackageNames": ["/eslint/"],
			"groupName": "eslint"
		},
		{
			"matchPackageNames": ["vite", "oxfmt", "eslint-plugin-oxlint", "/^@oxc-/", "/^oxc-/"],
			"groupName": "voidzero"
		},
		{
			"matchPackageNames": ["vitest", "/^@vitest\\//"],
			"groupName": "vitest"
		},
		{
			"description": "oxlint, @effect/tsgo and tsrs must move together (effect-tsgo drives both); a split update breaks the type-aware lint.",
			"matchPackageNames": [
				"effect",
				"/^@effect\\//",
				"oxlint",
				"oxlint-tsgolint",
				"/^@oxlint-tsgolint\\//",
				"tsrs",
				"/^@tsrs\\//"
			],
			"groupName": "effect"
		},
		{
			"matchPackageNames": ["drizzle-orm", "drizzle-kit"],
			"groupName": "drizzle"
		},
		{
			"matchPackageNames": ["/^openmls/"],
			"groupName": "openmls"
		},
		{
			"matchPackageNames": ["/^tailwindcss/", "/^@tailwindcss//", "daisyui"],
			"groupName": "tailwind"
		}
	]
}
